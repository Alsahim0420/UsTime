rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(spaceId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.members;
    }

    // Each person's own settings (active list, theme).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 6-digit invitation codes. The code is the document id, so it can only
    // be created once; nobody can change or list them.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['spaceId', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.spaceId is string;
    }

    // Shared lists. Only members can see one.
    match /spaces/{spaceId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Created together with its code, with the creator as only member.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.spaceId == spaceId;

      // Members can rename it. Anyone who got the list's id through its code
      // can add themselves (and only themselves) as a member.
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 30
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members)
      );

      match /items/{itemId} {
        allow read, write: if isMember(spaceId);
      }
    }
  }
}
